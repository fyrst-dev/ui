{
  "name": "@fyrst/ui",
  "version": "0.3.0",
  "description": "fyrst.dev design system: Panda CSS preset, Vue components, and Nuxt module",
  "license": "MIT",
  "author": "fyrst.dev",
  "type": "module",
  "homepage": "https://github.com/fyrst-dev/ui#readme",
  "bugs": {
    "url": "https://github.com/fyrst-dev/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyrst-dev/ui.git"
  },
  "keywords": [
    "vue",
    "nuxt",
    "ui",
    "components",
    "design-system",
    "fyrst",
    "pandacss"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./design-preset": {
      "types": "./dist/preset/index.d.ts",
      "import": "./dist/preset/index.js",
      "require": "./dist/preset/index.cjs"
    },
    "./preset": {
      "types": "./dist/preset/index.d.ts",
      "import": "./dist/preset/index.js",
      "require": "./dist/preset/index.cjs"
    },
    "./components": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt/types.d.mts",
      "import": "./dist/nuxt/module.mjs",
      "default": "./dist/nuxt/module.mjs"
    },
    "./nuxt-entries.json": "./dist/nuxt-entries.json",
    "./vue/*": {
      "types": "./dist/vue/*.d.ts",
      "import": "./dist/vue/*.js",
      "require": "./dist/vue/*.js",
      "default": "./dist/vue/*.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./dist/styled-system/css/index.d.ts",
      "default": "./dist/styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./dist/styled-system/css/*.d.ts",
      "default": "./dist/styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./dist/styled-system/patterns/index.d.ts",
      "default": "./dist/styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./dist/styled-system/patterns/*.d.ts",
      "default": "./dist/styled-system/patterns/*.js"
    },
    "./tokens": {
      "types": "./dist/styled-system/tokens/index.d.ts",
      "default": "./dist/styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./dist/styled-system/helpers.d.ts",
      "default": "./dist/styled-system/helpers.js"
    },
    "./types": {
      "types": "./dist/styled-system/types/index.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint packages/*/src --cache",
    "lint:fix": "eslint packages/*/src --fix --cache",
    "build": "rm -rf dist && bun run link:package && bun run build:preset && bun run build:components && bun run build:nuxt && bun scripts/assemble-dist.ts && bun run panda:lib",
    "build:preset": "bun run --filter='@fyrst/design-preset' build",
    "build:components": "bun run --filter='@fyrst/ui-components' build && mkdir -p dist && cp packages/components/dist/ui-components.css dist/style.css && rm -f packages/components/dist/ui-components.css && bun scripts/assemble-dist.ts",
    "build:nuxt": "bun run --filter='@fyrst/ui-nuxt' prepack",
    "panda:lib": "panda codegen --clean && panda lib --outdir dist --files './**/*.{js,mjs}' --panda '^2.4.0'",
    "link:package": "mkdir -p node_modules/@fyrst && ln -sfn ../.. node_modules/@fyrst/ui",
    "watch:preset": "bun run --filter='@fyrst/design-preset' watch",
    "dev:components": "bun run --filter='@fyrst/ui-components' dev",
    "dev:nuxt": "bun run link:package && bun scripts/assemble-dist.ts && bun run panda:lib && bun run --filter='@fyrst/ui-nuxt' dev",
    "dev:nuxt:prepare": "bun run link:package && bun scripts/assemble-dist.ts && bun run panda:lib && bun run --filter='@fyrst/ui-nuxt' dev:prepare",
    "dev:nuxt:build": "bun run dev:nuxt:prepare && bun run --filter='@fyrst/ui-nuxt' dev:build",
    "test": "bun run link:package && bun run --filter='@fyrst/ui-components' test && bun run --filter='@fyrst/ui-nuxt' test",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf packages/*/dist dist"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.0.0",
    "@nuxt/kit": "^4.6.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.3.4",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/types": "^2.4.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nuxt": "^4.6.3",
    "reka-ui": "^2.11.0",
    "typescript": "^5.9.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "ajv": "^8.20.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.44",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "reka-ui": "^2.11.0",
    "nuxt": "^4.6.3",
    "@nuxt/kit": "^4.6.3",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
