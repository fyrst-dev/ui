{
  "name": "@fyrst/ui",
  "version": "0.1.0",
  "description": "fyrst.dev design system: Panda CSS preset, Vue components, and Nuxt module",
  "license": "MIT",
  "author": "fyrst.dev",
  "type": "module",
  "homepage": "https://github.com/fyrst-dev/ui#readme",
  "bugs": {
    "url": "https://github.com/fyrst-dev/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyrst-dev/ui.git"
  },
  "keywords": [
    "vue",
    "nuxt",
    "ui",
    "components",
    "design-system",
    "fyrst",
    "pandacss"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": "./packages/components/dist/index.cjs",
  "module": "./packages/components/dist/index.js",
  "types": "./packages/components/dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "packages/preset/dist",
    "packages/components/dist",
    "packages/nuxt/dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./packages/components/dist/index.d.ts",
      "import": "./packages/components/dist/index.js",
      "require": "./packages/components/dist/index.cjs"
    },
    "./design-preset": {
      "types": "./packages/preset/dist/index.d.ts",
      "import": "./packages/preset/dist/index.js",
      "require": "./packages/preset/dist/index.cjs"
    },
    "./preset": {
      "types": "./packages/preset/dist/index.d.ts",
      "import": "./packages/preset/dist/index.js",
      "require": "./packages/preset/dist/index.cjs"
    },
    "./components": {
      "types": "./packages/components/dist/index.d.ts",
      "import": "./packages/components/dist/index.js",
      "require": "./packages/components/dist/index.cjs"
    },
    "./nuxt": {
      "types": "./packages/nuxt/dist/types.d.mts",
      "import": "./packages/nuxt/dist/module.mjs",
      "default": "./packages/nuxt/dist/module.mjs"
    },
    "./nuxt-entries.json": "./packages/components/dist/nuxt-entries.json",
    "./vue/*": {
      "import": "./packages/components/dist/vue/*.js",
      "require": "./packages/components/dist/vue/*.js",
      "default": "./packages/components/dist/vue/*.js"
    },
    "./style.css": "./dist/style.css",
    "./panda.buildinfo.json": "./dist/panda.buildinfo.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint packages/*/src --cache",
    "lint:fix": "eslint packages/*/src --fix --cache",
    "build": "bun run link:package && bun run build:preset && bun run build:components && bun run build:nuxt",
    "build:preset": "bun run --filter='@fyrst/design-preset' build",
    "build:components": "bun run --filter='@fyrst/ui-components' build && mkdir -p dist && cp packages/components/dist/panda.buildinfo.json dist/panda.buildinfo.json && cp packages/components/dist/ui-components.css dist/style.css && rm -f packages/components/dist/panda.buildinfo.json packages/components/dist/ui-components.css",
    "build:nuxt": "bun run --filter='@fyrst/ui-nuxt' prepack",
    "link:package": "mkdir -p node_modules/@fyrst && ln -sfn ../.. node_modules/@fyrst/ui",
    "watch:preset": "bun run --filter='@fyrst/design-preset' watch",
    "dev:components": "bun run --filter='@fyrst/ui-components' dev",
    "dev:nuxt": "bun run link:package && bun run --filter='@fyrst/ui-nuxt' dev",
    "dev:nuxt:prepare": "bun run link:package && bun run --filter='@fyrst/ui-nuxt' dev:prepare",
    "dev:nuxt:build": "bun run dev:nuxt:prepare && bun run --filter='@fyrst/ui-nuxt' dev:build",
    "test": "bun run link:package && bun run --filter='@fyrst/ui-nuxt' test",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf packages/*/dist dist"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@pandacss/dev": "^1.12.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.3",
    "typescript": "^5.9.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "ajv": "^8.20.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  },
  "peerDependencies": {
    "vue": "^3.5.12",
    "@pandacss/dev": "^1.0.1",
    "reka-ui": "^2.10.1",
    "nuxt": "^4.0.1",
    "@nuxt/kit": "^4.0.1",
    "typescript": "^5.9.2"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
