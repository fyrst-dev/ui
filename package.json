{
  "name": "@fyrst/ui",
  "private": true,
  "module": "index.ts",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    "./styled-system": {
      "types": "./packages/preset/dist/index.d.ts",
      "import": "./packages/preset/dist/index.js",
      "require": "./packages/preset/dist/index.cjs"
    },
    "./preset": {
      "types": "./packages/preset/dist/index.d.ts",
      "import": "./packages/preset/dist/index.js",
      "require": "./packages/preset/dist/index.cjs"
    },
    "./components": {
      "types": "./packages/components/dist/index.d.ts",
      "import": "./packages/components/dist/index.js",
      "require": "./packages/components/dist/index.cjs"
    },
    "./nuxt": {
      "types": "./packages/nuxt/dist/types.d.mts",
      "import": "./packages/nuxt/dist/module.mjs"
    }
  },
  "scripts": {
    "lint": "eslint packages/*/src --cache",
    "lint:fix": "eslint packages/*/src --fix --cache",
    "build": "bun run build:preset && bun run build:components && bun run build:nuxt",
    "build:styled-system": "bun run --filter='@fyrst/design-preset' build",
    "build:preset": "bun run build:styled-system",
    "build:components": "bun run --filter='@fyrst/ui-components' build",
    "build:nuxt": "bun run --filter='@fyrst/ui-nuxt' dev:prepare && bun run --filter='@fyrst/ui-nuxt' dev:build && bun run --filter='@fyrst/ui-nuxt' prepack",
    "watch:styled-system": "bun run --filter='@fyrst/design-preset' watch",
    "watch:preset": "bun run watch:styled-system",
    "dev:components": "bun run --filter='@fyrst/ui-components' dev",
    "dev:nuxt": "bun run --filter='@fyrst/ui-nuxt' dev",
    "dev:nuxt:prepare": "bun run --filter='@fyrst/ui-nuxt' dev:prepare",
    "test": "bun run --filter='@fyrst/ui-nuxt' test",
    "pack:check": "bun run build && bun publish --dry-run --cwd packages/preset && bun publish --dry-run --cwd packages/components && bun publish --dry-run --cwd packages/nuxt",
    "publish:packages": "bun publish --cwd packages/preset --access public && bun publish --cwd packages/components --access public && bun publish --cwd packages/nuxt --access public",
    "clean": "bun run --filter='packages/*' clean && rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@pandacss/dev": "^1.12.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.3",
    "typescript": "^5.9.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "ajv": "^8.20.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  }
}