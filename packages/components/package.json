{
    "name": "@fyrst/ui-components",
    "version": "0.4.0",
    "private": true,
    "description": "Vue 3 UI components for the fyrst.dev design system",
    "license": "MIT",
    "author": "fyrst.dev",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "homepage": "https://github.com/fyrst-dev/ui/tree/master/packages/components#readme",
    "bugs": {
        "url": "https://github.com/fyrst-dev/ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fyrst-dev/ui.git",
        "directory": "packages/components"
    },
    "keywords": [
        "vue",
        "ui",
        "components",
        "design-system",
        "fyrst",
        "pandacss"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./style.css": "./dist/ui-components.css"
    },
    "scripts": {
        "codegen": "panda codegen --clean",
        "build": "bun run clean && bun run codegen && bun run build:icons && bun run generate:vue-entries && vite build && vue-tsc --emitDeclarationOnly",
        "build:icons": "bun run build.icons",
        "generate:vue-entries": "bun write-vue-entry-modules.ts",
        "dev": "vite dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist src/vue"
    },
    "devDependencies": {
        "@fyrst/design-preset": "workspace:*",
        "@pandacss/dev": "^2.4.0",
        "@pandacss/preset-base": "^2.4.0",
        "@iconify/json": "^2.2.548",
        "@iconify/utils": "^3.1.7",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "happy-dom": "^21.0.4",
        "sass-embedded": "^1.106.1",
        "vite": "^8.2.1",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "vue": "^3.5.41",
        "@fyrst/design-preset": "^0.4.0",
        "@pandacss/dev": "^2.4.0",
        "@pandacss/preset-base": "^2.4.0",
        "reka-ui": "^2.10.3"
    }
}
