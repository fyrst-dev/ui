{
    "name": "@fyrst/ui-nuxt",
    "version": "0.1.0",
    "description": "Nuxt module for the Fyrst Digital Vue UI components",
    "license": "MIT",
    "author": "Fyrst Digital",
    "type": "module",
    "homepage": "https://github.com/fyrst-digital/ui/tree/master/packages/nuxt#readme",
    "bugs": {
        "url": "https://github.com/fyrst-digital/ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fyrst-digital/ui.git",
        "directory": "packages/nuxt"
    },
    "keywords": [
        "nuxt",
        "nuxt-module",
        "vue",
        "ui",
        "components",
        "design-system",
        "fyrst"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/types.d.mts"
            ]
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "prepack": "nuxt-module-build build",
        "prepublishOnly": "nuxt-module-build build",
        "dev": "bun run dev:prepare && cd playground && bun run dev",
        "dev:build": "cd playground && bun run prepare && nuxi build",
        "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
        "release": "bun run lint && bun run test && bun run prepack && changelogen --release && bun publish --access public && git push --follow-tags",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
    },
    "dependencies": {
        "@fyrst/design-preset": "workspace:*",
        "@fyrst/ui-components": "workspace:*",
        "@nuxt/kit": "^4.5.2"
    },
    "peerDependencies": {
        "nuxt": "^4.5.2",
        "vue": "^3.5.41",
        "@pandacss/dev": "^1.0.1",
        "reka-ui": "^2.10.3"
    }
}
