{
  "name": "@fyrst/design-preset",
  "version": "0.1.0",
  "private": true,
  "description": "Panda CSS preset with fyrst.dev design tokens",
  "license": "MIT",
  "author": "fyrst.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/fyrst-dev/ui#readme",
  "bugs": {
    "url": "https://github.com/fyrst-dev/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyrst-dev/ui.git",
    "directory": "packages/preset"
  },
  "keywords": [
    "pandacss",
    "design-tokens",
    "design-system",
    "fyrst"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "codegen": "panda codegen",
    "build": "bun run codegen && tsup src/index.ts --format esm,cjs --dts --clean",
    "watch": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.0",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "@pandacss/dev": "^1.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  }
}
