{
  "name": "@fyrst/design-preset",
  "version": "0.1.0",
  "description": "Panda CSS preset with Fyrst Digital design tokens",
  "license": "MIT",
  "author": "Fyrst Digital",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/fyrst-digital/ui#readme",
  "bugs": {
    "url": "https://github.com/fyrst-digital/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyrst-digital/ui.git",
    "directory": "packages/preset"
  },
  "keywords": [
    "pandacss",
    "design-tokens",
    "design-system",
    "fyrst"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "css",
    "tokens",
    "types",
    "patterns",
    "recipes",
    "jsx",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "codegen": "panda codegen",
    "build": "bun run codegen && tsup src/index.ts --format esm,cjs --dts --clean",
    "watch": "tsup src/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.0",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "@pandacss/dev": "^1.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./css": {
      "types": "./css/index.d.ts",
      "require": "./css/index.mjs",
      "import": "./css/index.mjs"
    },
    "./tokens": {
      "types": "./tokens/index.d.ts",
      "require": "./tokens/index.mjs",
      "import": "./tokens/index.mjs"
    },
    "./types": {
      "types": "./types/index.d.ts",
      "require": "./types/index.mjs",
      "import": "./types/index.mjs"
    },
    "./patterns": {
      "types": "./patterns/index.d.ts",
      "require": "./patterns/index.mjs",
      "import": "./patterns/index.mjs"
    },
    "./jsx": {
      "types": "./jsx/index.d.ts",
      "require": "./jsx/index.mjs",
      "import": "./jsx/index.mjs"
    }
  }
}
